# Variables de entorno
# Copia este archivo como .env.local y rellena los valores con tus credenciales.
# NUNCA pongas valores reales aquí: solo los nombres de las variables.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# URL pública del sitio. Se usa para los enlaces que se comparten por WhatsApp.
# En producción debe ser el dominio real (https://...).
NEXT_PUBLIC_SITE_URL=https://tu-dominio.com

# Cloudinary (imágenes)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=tu-api-key
CLOUDINARY_API_SECRET=tu-api-secret

# ---------------------------------------------------------------------------
# El número de WhatsApp NO va aquí: se configura desde el panel de
# administración (Ajustes → Número de WhatsApp) y se guarda en la tabla
# `settings` de Supabase. Así se puede cambiar sin volver a desplegar y no
# queda ningún número de ejemplo en el repositorio.
# ---------------------------------------------------------------------------
